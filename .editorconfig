root = true

[*]
indent_style = space
indent_size = 4
trim_trailing_whitespace = true
insert_final_newline = true

# PowerShell 5.1 在 Windows 上按 ANSI 解码无 BOM 的 .ps1，
# 中文会变乱码并直接导致语法错误 —— 必须带 BOM。
[*.ps1]
charset = utf-8-bom
indent_size = 4
end_of_line = crlf

# .bat 不能带 BOM（cmd 会把 BOM 当成命令的一部分），所以只规定换行
[*.bat]
charset = utf-8
end_of_line = crlf

[*.{md,json,yml,yaml}]
charset = utf-8
end_of_line = lf

[*.py]
charset = utf-8
indent_size = 4
end_of_line = lf

[*.txt]
charset = utf-8
end_of_line = crlf
