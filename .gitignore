# ---- 依赖与运行数据：由 installer 下载，不入库 ----
/app/*
!/app/.gitkeep
/napcat/*
!/napcat/.gitkeep
/_dl/

# ---- AstrBot 运行期产物（含 API Key、数据库、日志） ----
**/data/
**/logs/
*.db
*.db-journal
*.bak_*

# ---- 诊断输出 ----
诊断_*.zip
诊断结果_*/

# ---- 本机人设：可能含私人信息，绝不入库 ----
persona_local/
preset/persona/_我的设定.md

# ---- 打包产物 ----
/release/
*.zip

# ---- 系统垃圾 ----
Thumbs.db
desktop.ini
.DS_Store

# ---- Python ���� ----
__pycache__/
*.pyc
